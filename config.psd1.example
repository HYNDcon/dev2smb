# dev2smb/config.psd1

@{
  # =====================================================================
  # dev2smb 配置文件
  # 用于批量部署 SMB 共享账户、文件夹、共享权限与防火墙规则
  # =====================================================================

  # prefix = 资源命名前缀。1 ~ 3 字符，只允许 [a-z0-9._-]
  #          用于生成账户名、共享名和防火墙规则名。
  prefix  = 'd2s'

  # tag = 资源归属标签。格式为 [a-z0-9._-]，必须带方括号。
  #       脚本依靠此标签来识别"哪些资源是脚本创建的"。
  tag     = '[dev2smb]'

  # devices = 设备列表。每台需要接入 SMB 的设备（复印机、PC、服务器等）一个条目。
  # ---------------------------------------------------------------------
  # 字段说明：
  #   suffix = 账户名后缀，同时作为共享名/防火墙规则名的基础、文件夹名。
  #     1 ~ 16 字符，只允许 [a-z0-9._-]
  #     注意：prefix + '-' + suffix 总长不能超过 20 个字符（Windows 账户名限制）
  #     smb-share: {prefix}-{suffix}
  #     fw-rule:   {prefix}-{suffix}
  #     folder:    {脚本目录}\{suffix}
  #
  #   ip  = 设备 IP，用于防火墙规则的 RemoteAddress
  #
  #   pw  = 账户密码（必须用单引号！双引号会展开变量）
  # ---------------------------------------------------------------------
  devices = @(
    # 1. A3 彩色多功能复印机 (MFP)
    @{ suffix = 'epson-c5790-3f'; ip = '192.168.1.240'; pw = 'CHANGE_ME' }
    
    # 2. 会议室 A4 桌面激光一体机 (HP)
    @{ suffix = 'hp-m428-rm201'; ip = '192.168.1.241'; pw = 'CHANGE_ME' }
    
    # 3. 财务部高速文档扫描仪 (Fujitsu)
    @{ suffix = 'fuji-fi7160-fin'; ip = '192.168.1.242'; pw = 'CHANGE_ME' }
    
    # 4. 生产线 Windows PC (上传机台日志)
    @{ suffix = 'pc-line01-win10'; ip = '192.168.1.150'; pw = 'CHANGE_ME' }
    
    # 5. Linux 服务器 (定时抓取扫描件)
    @{ suffix = 'srv-linux-bk'; ip = '192.168.1.100'; pw = 'CHANGE_ME' }
    
    # 6. Mac 电脑 (设计师存图)
    @{ suffix = 'mac-design-01'; ip = '192.168.1.155'; pw = 'CHANGE_ME' }
    
    # 7. 监控 NVR (直接写入录像)
    @{ suffix = 'hik-nvr-1f'; ip = '192.168.1.80'; pw = 'CHANGE_ME' }
  )
}